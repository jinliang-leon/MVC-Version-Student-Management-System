# ============================================================
# 学生管理系统 - 环境变量配置模板
# 用法：复制为 .env 后填入真实值  （cp .env.example .env）
# ============================================================

# ---------- 应用信息 ----------
APP_NAME=学生管理系统
DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8001

# ---------- 数据库 ----------
# 方式一（优先）：完整连接串，设置后下面 DB_* 分字段将被忽略
DATABASE_URL=mysql+pymysql://root:your_password_here@127.0.0.1:3306/student_management?charset=utf8mb4
# 方式二（回退）：当 DATABASE_URL 留空时，由以下分字段拼接连接串
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password_here
# DB_NAME=student_management

# ---------- JWT 认证 ----------
# 密钥务必配置为强随机值；生产环境切勿使用默认占位符
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------- 初始管理员（seed_rbac.py 使用） ----------
# 生产环境务必把 ADMIN_PASSWORD 改为强密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---------- 日志 ----------
LOG_LEVEL=INFO
# 其余日志项（LOG_DIR、LOG_FILE、LOG_ROTATION、LOG_BACKUP_COUNT、LOG_MAX_BYTES）
# 未设置时使用 config.py 中的默认值

# ---------- 其他可选配置 ----------
# 未在此列出的项（CORS_ORIGINS、DEFAULT_PAGE_SIZE、MAX_PAGE_SIZE 等）
# 见 app/core/config.py，未设置时使用其默认值
