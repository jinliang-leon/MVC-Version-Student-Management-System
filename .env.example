# ============================================================
# 学生管理系统 - 环境变量配置模板
# 用法：复制为 .env 后填入真实值  （cp .env.example .env）
# ============================================================

# ---------- 应用信息 ----------
APP_NAME=学生管理系统
# APP_VERSION / APP_DESCRIPTION 使用代码内默认值（1.0.0 / 见 app/core/config.py），通常无需覆盖
APP_HOST=0.0.0.0
APP_PORT=8001
DEBUG=True

# ---------- 数据库 ----------
# 方式一（优先）：完整连接串，设置后下面 DB_* 分字段将被忽略
DATABASE_URL=mysql+pymysql://root:your_password_here@127.0.0.1:3306/student_management?charset=utf8mb4
# 方式二（回退）：当 DATABASE_URL 留空时，由以下分字段拼接连接串
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password_here
# DB_NAME=student_management

# ---------- JWT 认证（已实装） ----------
# 登录接口签发 access_token，RBAC 装饰器按 Token 鉴权；以下配置均已生效。
# SECRET_KEY 默认值仅供本地开发，生产环境务必替换为强随机值：
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30       # access_token 有效期（分钟）
REFRESH_TOKEN_EXPIRE_MINUTES=10080   # refresh_token 有效期（分钟，7 天）；生成函数已就绪，登录接口当前仅签发 access_token

# ---------- 初始管理员（seed_rbac.py 使用） ----------
# 生产环境务必把 ADMIN_PASSWORD 改为强密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# ---------- CORS ----------
CORS_ORIGINS=*    # 多个来源用逗号分隔，如 http://localhost:3000,http://127.0.0.1:3000

# ---------- 分页 ----------
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# ---------- 日志 ----------
LOG_LEVEL=INFO
# 以下日志项未设置时使用 config.py 中的默认值；如需覆盖可取消注释
# LOG_PROJECT_NAME=student-management
# LOG_DIR=logs                  # 相对路径锚定项目根目录 -> <项目根>/logs（与 app 同级）
# LOG_FILE=app.log
# LOG_BACKUP_COUNT=5            # 滚动文件保留的备份数
# LOG_MAX_BYTES=10485760        # 单个文件最大字节（10MB，RotatingFileHandler 滚动阈值）
